{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "obsidia-app",
  "version": "0.1.0",
  "identifier": "com.obsidia.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "obsidia-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1OEM3NjVGNUU4MTlFRkIKUldUN25vRmVYM2FNUmFyUzdnUmNOaDNDT2FER3hFRkxDeDYxNUNuSFIrME5NUXh4YzRjRys5RHEK",
      "endpoints": [
        "https://github.com/obsidia/obsidia/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
